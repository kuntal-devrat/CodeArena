generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  bio          String?
  createdAt    DateTime @default(now())

  submissions  Submission[]
  roomMembers  RoomMember[]
  peekRequests PeekRequest[] @relation("requester")
  peekTargets  PeekRequest[] @relation("target")
}

model Problem {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  difficulty  Difficulty
  tags        String[]
  description String
  examples    Json
  constraints String[]
  starterCode Json     // { python: "...", javascript: "..." }
  testCases   Json     // hidden test cases for judge
  createdAt   DateTime @default(now())

  submissions Submission[]
}

model Submission {
  id           String            @id @default(cuid())
  userId       String
  problemId    String
  language     String
  code         String
  verdict      SubmissionVerdict @default(PENDING)
  runtime      Int?
  memory       Int?
  errorMessage String?
  submittedAt  DateTime          @default(now())

  user    User    @relation(fields: [userId], references: [id])
  problem Problem @relation(fields: [problemId], references: [id])
}

model Room {
  id         String         @id @default(cuid())
  name       String
  mode       RoomMode       @default(FREE_PRACTICE)
  visibility RoomVisibility @default(FRIENDS)
  hostId     String
  problemId  String?
  startedAt  DateTime?
  endsAt     DateTime?
  createdAt  DateTime       @default(now())

  members      RoomMember[]
  peekRequests PeekRequest[]
}

model RoomMember {
  id       String           @id @default(cuid())
  roomId   String
  userId   String
  status   MemberStatus     @default(IDLE)
  isHost   Boolean          @default(false)
  joinedAt DateTime         @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
}

model PeekRequest {
  id              String      @id @default(cuid())
  roomId          String
  requesterId     String
  targetId        String
  status          PeekStatus  @default(PENDING)
  durationSeconds Int         @default(90)
  createdAt       DateTime    @default(now())
  expiresAt       DateTime?

  room      Room @relation(fields: [roomId], references: [id])
  requester User @relation("requester", fields: [requesterId], references: [id])
  target    User @relation("target", fields: [targetId], references: [id])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionVerdict {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILE_ERROR
}

enum RoomMode {
  FREE_PRACTICE
  SAME_PROBLEM
  HEAD_TO_HEAD
}

enum RoomVisibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

enum MemberStatus {
  IDLE
  CODING
  SUBMITTED
  SPECTATING
}

enum PeekStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  REVOKED
}
